# Shell launchers must stay LF even when checked out on Windows, or bash on a
# Mac rejects the shebang line. Windows launchers keep CRLF for cmd.exe.
*.sh  text eol=lf
*.bat text eol=crlf
*.vbs text eol=crlf

# Vendored third-party files are kept byte-identical to the published release
# so their hash can be checked against the CDN copy.
src/dashboard/static/vendor/** -text
