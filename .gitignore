.venv/
__pycache__/
*.pyc
*.pyo
.env
*.wav
*.log
ruvector.db

# Your working config. The tracked one is packaging/default/config.yaml, which
# main.py copies here on first run. Keeping this untracked is what stops a
# maintainer's switched-on cloud settings from becoming every cloner's default.
/config.yaml
.pytest_cache/
.coverage

# Runtime data — everything in data/ except the .gitkeep placeholder
data/*
!data/.gitkeep

# Same for logs/
logs/*
!logs/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
build/
dist/
dist_nuitka/
.claude/
*.spec.bak

# Local icon backups (originals preserved in git history)
assets/_original_icons/

# Personal walkthrough script — kept local, not for the public repo
docs/VIDEO_SCRIPT.md
